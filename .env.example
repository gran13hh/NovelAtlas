# Maximum accepted TXT upload size (50 MiB).
NOVELATLAS_MAX_UPLOAD_BYTES=52428800

# Uploaded source lifetime in seconds (1 hour).
NOVELATLAS_UPLOAD_TTL_SECONDS=3600

# Interval for checking expired tasks in seconds.
NOVELATLAS_CLEANUP_INTERVAL_SECONDS=60

# Stage 3 long-text parsing defaults. The overlap must be smaller than the
# maximum chunk size.
NOVELATLAS_TOKENIZER_NAME=o200k_base
NOVELATLAS_CHUNK_MAX_TOKENS=6000
NOVELATLAS_CHUNK_OVERLAP_TOKENS=300

# Stage 4 model gateway. Text and image providers are configured separately.
# Keep "mock" for local development without API keys. To use OpenAI, change
# the provider to "openai", choose a model, and set the corresponding key.
NOVELATLAS_TEXT_MODEL_PROVIDER=mock
NOVELATLAS_TEXT_MODEL_NAME=novelatlas-mock-text
NOVELATLAS_TEXT_MODEL_BASE_URL=https://api.openai.com/v1
# NOVELATLAS_TEXT_MODEL_API_KEY=

NOVELATLAS_IMAGE_MODEL_PROVIDER=mock
NOVELATLAS_IMAGE_MODEL_NAME=novelatlas-mock-image
NOVELATLAS_IMAGE_MODEL_BASE_URL=https://api.openai.com/v1
# NOVELATLAS_IMAGE_MODEL_API_KEY=

NOVELATLAS_MODEL_TIMEOUT_SECONDS=60
NOVELATLAS_MODEL_MAX_RETRIES=2
NOVELATLAS_MODEL_RETRY_BASE_DELAY_SECONDS=0.25
