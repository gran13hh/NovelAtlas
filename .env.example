# Maximum accepted TXT upload size (50 MiB).
NOVELATLAS_MAX_UPLOAD_BYTES=52428800

# Uploaded source lifetime in seconds (1 hour).
NOVELATLAS_UPLOAD_TTL_SECONDS=3600

# Interval for checking expired tasks in seconds.
NOVELATLAS_CLEANUP_INTERVAL_SECONDS=60

# Stage 3 long-text parsing defaults. The overlap must be smaller than the
# maximum chunk size.
NOVELATLAS_TOKENIZER_NAME=o200k_base
NOVELATLAS_CHUNK_MAX_TOKENS=6000
NOVELATLAS_CHUNK_OVERLAP_TOKENS=300

# Stage 5 analysis planning. Available source content per request is the lower
# of max input and (context window - output reserve), minus the safety margin.
NOVELATLAS_ANALYSIS_CONTEXT_WINDOW_TOKENS=128000
NOVELATLAS_ANALYSIS_MAX_INPUT_TOKENS=24000
NOVELATLAS_ANALYSIS_OUTPUT_RESERVE_TOKENS=4000
NOVELATLAS_ANALYSIS_SAFETY_MARGIN_TOKENS=2000

# Stage 4 text model gateway. Keep "mock" for local development without an API
# key. To use an OpenAI-compatible provider, change the provider, model and URL,
# then set the key.
NOVELATLAS_TEXT_MODEL_PROVIDER=mock
NOVELATLAS_TEXT_MODEL_NAME=novelatlas-mock-text
NOVELATLAS_TEXT_MODEL_BASE_URL=https://api.openai.com/v1
# NOVELATLAS_TEXT_MODEL_API_KEY=

NOVELATLAS_MODEL_TIMEOUT_SECONDS=60
NOVELATLAS_MODEL_MAX_RETRIES=2
NOVELATLAS_MODEL_RETRY_BASE_DELAY_SECONDS=0.25

# DeepSeek uses Chat Completions, not the OpenAI Responses adapter.
# To enable: replace the three existing text-model values above with these:
# NOVELATLAS_TEXT_MODEL_PROVIDER=deepseek
# NOVELATLAS_TEXT_MODEL_NAME=deepseek-flash
# NOVELATLAS_TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# NOVELATLAS_TEXT_MODEL_API_KEY=<your-private-key>
# Verify the model ID against the official /models response when configuring.
